target
Cargo.lock
# The verifier builds with cargo --offline from the vendored sources; the
# workspace lock must be committed for offline resolution to be possible.
!Cargo.lock

# test binaries
*.elf

# editors
.*.swp
/.idea/*
.config.env

# public parameter files
*.zst

# proof file
nexus-proof

# macos
.DS_Store

# benchmarks
benchmarks/results/*

# graphs
benchmarks/graphs/*

# proof files
*.proof
